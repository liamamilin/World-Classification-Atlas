SELECT DISTINCT ?g ?s ?p ?o WHERE { GRAPH <http://data.europa.eu/ux2/nace2.1/nace2.1> { ?o <http://www.w3.org/2004/02/skos/core#inScheme> <http://data.europa.eu/ux2/nace2.1/nace2.1> } VALUES ?p { <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.w3.org/2004/02/skos/core#closeMatch> <http://www.w3.org/2004/02/skos/core#narrowMatch> <http://www.w3.org/2004/02/skos/core#broadMatch> <http://www.w3.org/2004/02/skos/core#relatedMatch> } GRAPH ?g { ?s ?p ?o } FILTER(REGEX(STR(?s), "isic", "i")) } ORDER BY ?g ?s ?p ?o