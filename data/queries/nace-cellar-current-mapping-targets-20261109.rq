SELECT DISTINCT ?p (REPLACE(STR(?o),"/[^/]*$","") AS ?targetNamespace) WHERE { GRAPH ?g { ?s <http://www.w3.org/2004/02/skos/core#inScheme> <http://data.europa.eu/ux2/nace2.1/nace2.1> ; ?p ?o . VALUES ?p { <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.w3.org/2004/02/skos/core#closeMatch> <http://www.w3.org/2004/02/skos/core#narrowMatch> <http://www.w3.org/2004/02/skos/core#broadMatch> <http://www.w3.org/2004/02/skos/core#relatedMatch> } } } ORDER BY ?p ?targetNamespace